       IDENTIFICATION DIVISION.
       PROGRAM-ID. ABENDW.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO "ABOUT".
           SELECT IN-FILE ASSIGN TO "ABSENT".
       DATA DIVISION.
       FILE SECTION.
       FD  OUT-FILE.
       01  OUT-REC PIC X(10).
       FD  IN-FILE.
       01  IN-REC PIC X(10).
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT OUT-FILE
           MOVE "RECORD ONE" TO OUT-REC
           WRITE OUT-REC
           MOVE "RECORD TWO" TO OUT-REC
           WRITE OUT-REC
           OPEN INPUT IN-FILE
           DISPLAY "NOT REACHED"
           STOP RUN.
