{
  "about": "Katana's modules (docs/ROADMAP.md 3.3): one per concern, each with its purpose, what it takes and gives, what it may import and what it must not. test/modules.test holds every import in the source to this file. importsFrom says where an entry's import lists come from: 'roadmap' when 3.3 states them, 'pipeline' when they are read off the pipeline of 3.1 because 3.3 is silent. entryPoints are filled as each module is built.",
  "rules": [
    {
      "id": "MOD-01",
      "rule": "No module imports a model client.",
      "source": "R-004"
    },
    {
      "id": "MOD-02",
      "rule": "rt/ imports nothing: no module of ours, no third-party library. It ships inside the customer's suite.",
      "source": "ROADMAP 3.3"
    },
    {
      "id": "MOD-03",
      "rule": "lower/ reads sir/ only and decides nothing: every branch on a COBOL property is in sir/ or intent/.",
      "source": "ROADMAP 3.3, 4.2"
    },
    {
      "id": "MOD-04",
      "rule": "passes/ writes Java only through lower/'s emitter, so no pass can lose a provenance comment.",
      "source": "ROADMAP 3.3, R-024 (reserved)"
    },
    {
      "id": "MOD-05",
      "rule": "oracle/ never imports lower/ or passes/: the referee does not read the players' code.",
      "source": "ROADMAP 3.3"
    },
    {
      "id": "MOD-06",
      "rule": "front/ knows nothing of what COBOL means: it imports no module of ours.",
      "source": "ROADMAP 3.3"
    }
  ],
