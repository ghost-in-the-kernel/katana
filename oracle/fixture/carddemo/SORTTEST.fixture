# CardDemo's sample SORTTEST (carddemo:samples/jcl/SORTTEST.jcl): the transaction backup sorted by
# card number, keeping one processing date. The backup is POSTTRAN's KSDS as unloaded; every one of
# its transactions is dated 2024-03-01 by the pinned clock, so the sample's 2022-06-02 keeps none.
job SORTTEST
source carddemo:samples/jcl/SORTTEST.jcl
profile ibm sha256:25d21d9dc3d4db6554821c53cb0927a5bcc95f750d04631a50e43bb636866296
clock 2024-03-01 12:00:00.00 +00:00
tz UTC
# CUSTREC.cpy was written with 4-column tabs: at 8 its PICTUREs run past column 72 and CBSTM03A
# does not compile, at 4 it does (R-016, J-044); the evidence and the hypothesis.
tabs 4 CUSTREC.cpy

dataset AWS.M2.CARDDEMO.TRANSACT.BKUP org=GDG
dataset AWS.M2.CARDDEMO.TRANSACT.BKUP(0) org=PS lrecl=350 from=job:POSTTRAN:AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS sha256=f0bba3690bac767f905467aba771852e345763530f284cdd723daef43620f96b
dataset AWS.M2.CARDDEMO.TRANSACT.DALY org=GDG

step STEP05R pgm=SORT
dd SORTIN dsn=AWS.M2.CARDDEMO.TRANSACT.BKUP(0) disp=SHR recfm=FB lrecl=350 copybook=CVTRA05Y encoding=ascii
dd SYMNAMES inline
| TRAN-CARD-NUM,263,16,ZD
| TRAN-PROC-DT,305,10,CH
| PARM-DATE,C'2022-06-02'
dd SYSIN inline
|  SORT FIELDS=(TRAN-CARD-NUM,A)
|  INCLUDE COND=(TRAN-PROC-DT,EQ,PARM-DATE)
dd SYSOUT sysout
# DCB=(*.SORTIN): the backup's record format.
dd SORTOUT dsn=AWS.M2.CARDDEMO.TRANSACT.DALY(+1) disp=NEW,CATLG,DELETE recfm=FB lrecl=350 copybook=CVTRA05Y encoding=ascii
