# CardDemo's INTCALC (carddemo:app/jcl/INTCALC.jcl): CBACT04C computes interest from the category
# balances and writes the interest transactions to a new generation. Its PARM is the run date; a
# lane passes it through a PARM driver (phase 1.4). XREFFIL1 is the path over the cross-reference's
# alternate index (account id): IBM's convention names it after XREFFILE, and CBACT04C reads it
# through XREFFILE's ALTERNATE RECORD KEY, not by its own ASSIGN.
job INTCALC
source carddemo:app/jcl/INTCALC.jcl
profile ibm sha256:52d692671d1cfaa5a0c2ad904b95afebee05e5c20773de44ffa7fcaa5edb2c88
clock 2024-03-01 12:00:00.00 +00:00
tz UTC
stub CEE3ABD

dataset AWS.M2.CARDDEMO.TCATBALF.VSAM.KSDS org=KSDS lrecl=50 keys=17,0 from=carddemo:app/data/ASCII/tcatbal.txt framing=lines sha256=edaaf7202b8ddd35053db4ac59b992bc3eb5ef64aac22bab9b2aeb6bf6aadd68
dataset AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS org=KSDS lrecl=50 keys=16,0 from=carddemo:app/data/ASCII/cardxref.txt framing=lines sha256=d49145cf821e7aae049706569b8bf90f6fb52e0fcc53e8099e39beb55e5c7056
dataset AWS.M2.CARDDEMO.CARDXREF.VSAM.AIX.PATH org=PATH over=AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS keys=11,25 unique=no
dataset AWS.M2.CARDDEMO.ACCTDATA.VSAM.KSDS org=KSDS lrecl=300 keys=11,0 from=carddemo:app/data/ASCII/acctdata.txt framing=lines sha256=00a9fd689c9e572a60101afa688ab210f2f012f70040d219617d6134bb708649
# Not in key order as CardDemo ships it (the study: file status 21 loading it unsorted); a KSDS's
# records are its records in key order, whatever order they came in.
dataset AWS.M2.CARDDEMO.DISCGRP.VSAM.KSDS org=KSDS lrecl=50 keys=16,0 from=carddemo:app/data/ASCII/discgrp.txt framing=lines sha256=57595cd33cb90c6c419db764056bbb4060a1ac48a8832d81c938b044a54af5c5
dataset AWS.M2.CARDDEMO.SYSTRAN org=GDG

step STEP15 pgm=CBACT04C parm=2022071800
dd SYSPRINT sysout
dd SYSOUT sysout
dd TCATBALF dsn=AWS.M2.CARDDEMO.TCATBALF.VSAM.KSDS disp=SHR recfm=F lrecl=50 copybook=CVTRA01Y encoding=ascii
dd XREFFILE dsn=AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS disp=SHR recfm=F lrecl=50 copybook=CVACT03Y encoding=ascii
dd XREFFIL1 dsn=AWS.M2.CARDDEMO.CARDXREF.VSAM.AIX.PATH disp=SHR recfm=F lrecl=50 copybook=CVACT03Y encoding=ascii
dd ACCTFILE dsn=AWS.M2.CARDDEMO.ACCTDATA.VSAM.KSDS disp=SHR recfm=F lrecl=300 copybook=CVACT01Y encoding=ascii
dd DISCGRP dsn=AWS.M2.CARDDEMO.DISCGRP.VSAM.KSDS disp=SHR recfm=F lrecl=50 copybook=CVTRA02Y encoding=ascii
dd TRANSACT dsn=AWS.M2.CARDDEMO.SYSTRAN(+1) disp=NEW,CATLG,DELETE recfm=F lrecl=350 copybook=CVTRA05Y encoding=ascii
