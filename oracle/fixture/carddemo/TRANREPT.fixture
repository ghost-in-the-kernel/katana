# CardDemo's TRANREPT (carddemo:app/jcl/TRANREPT.jcl): back up the transaction KSDS (the REPROC
# procedure, expanded here), sort the backup by card number keeping one date range, and print the
# report with CBTRN03C. The KSDS starts as POSTTRAN leaves it, by its key-ordered unload's hash.
# The JCL names two steps STEP05R; the procedure's is STEP05R.PRC001 once expanded.
#
# Written as the JCL says (R-009): the date range 2022-01-01 to 2022-07-06. POSTTRAN under this clock
# dates every transaction 2024-03-01, so this range selects none of them; the study's run, whose
# frozen hashes are held, is TRANREPT-STUDY.fixture. DATEPARM is not in CardDemo; this one states
# the JCL's range. The cobc lane stops this job at its first step: REPROCT's licence comment opens
# in column 1, which IDCAMS does not read (J-035).
job TRANREPT
source carddemo:app/jcl/TRANREPT.jcl
profile ibm sha256:cc4bbf084793b6f5280da870d1aa7b6fb58d535dcfaf091d8436a36a66c4dae1
clock 2024-03-01 12:00:00.00 +00:00
tz UTC
# CUSTREC.cpy was written with 4-column tabs: at 8 its PICTUREs run past column 72 and CBSTM03A
# does not compile, at 4 it does (R-016, J-044); the evidence and the hypothesis.
tabs 4 CUSTREC.cpy
stub CEE3ABD

dataset AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS org=KSDS lrecl=350 keys=16,0 from=job:POSTTRAN sha256=f0bba3690bac767f905467aba771852e345763530f284cdd723daef43620f96b
dataset AWS.M2.CARDDEMO.CNTL(REPROCT) org=PS lrecl=80 from=carddemo:app/ctl/REPROCT.ctl framing=lines sha256=d4be5d9e718500a6c3865f3c1857887ab2e024133019e38385ecd5290a381098
dataset AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS org=KSDS lrecl=50 keys=16,0 from=carddemo:app/data/ASCII/cardxref.txt framing=lines sha256=d49145cf821e7aae049706569b8bf90f6fb52e0fcc53e8099e39beb55e5c7056
dataset AWS.M2.CARDDEMO.TRANTYPE.VSAM.KSDS org=KSDS lrecl=60 keys=2,0 from=carddemo:app/data/ASCII/trantype.txt framing=lines sha256=00e01dfa3a2144cc485dd57c91afe44eb69fbd8b6455e7f27329535820dac8ec
dataset AWS.M2.CARDDEMO.TRANCATG.VSAM.KSDS org=KSDS lrecl=60 keys=6,0 from=carddemo:app/data/ASCII/trancatg.txt framing=lines sha256=b0e57c7d51e580f3c25aad6c501ce02e04fdaeecb2d8b93d7bfb22692a8d86b9
dataset AWS.M2.CARDDEMO.DATEPARM org=PS lrecl=80 from=repo:oracle/fixture/carddemo/DATEPARM framing=fixed sha256=977eb655f982819c7784cf08c5bef0fe328ea3673815ab086744f3c988ce05fd
dataset AWS.M2.CARDDEMO.TRANSACT.BKUP org=GDG
dataset AWS.M2.CARDDEMO.TRANSACT.DALY org=GDG
dataset AWS.M2.CARDDEMO.TRANREPT org=GDG

step STEP05R.PRC001 pgm=IDCAMS
dd SYSPRINT sysout
dd FILEIN dsn=AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS disp=SHR recfm=F lrecl=350 copybook=CVTRA05Y encoding=ascii
dd FILEOUT dsn=AWS.M2.CARDDEMO.TRANSACT.BKUP(+1) disp=NEW,CATLG,DELETE recfm=FB lrecl=350 copybook=CVTRA05Y encoding=ascii
dd SYSIN dsn=AWS.M2.CARDDEMO.CNTL(REPROCT) disp=SHR recfm=F lrecl=80 copybook=- encoding=ascii

step STEP05R pgm=SORT
dd SORTIN dsn=AWS.M2.CARDDEMO.TRANSACT.BKUP(+1) disp=SHR recfm=FB lrecl=350 copybook=CVTRA05Y encoding=ascii
dd SYMNAMES inline
| TRAN-CARD-NUM,263,16,ZD
| TRAN-PROC-DT,305,10,CH
| PARM-START-DATE,C'2022-01-01'                                      //Date
| PARM-END-DATE,C'2022-07-06'                                        //Date
dd SYSIN inline
|  SORT FIELDS=(TRAN-CARD-NUM,A)
|  INCLUDE COND=(TRAN-PROC-DT,GE,PARM-START-DATE,AND,
|          TRAN-PROC-DT,LE,PARM-END-DATE)
dd SYSOUT sysout
# DCB=(*.SORTIN): the backup's record format.
dd SORTOUT dsn=AWS.M2.CARDDEMO.TRANSACT.DALY(+1) disp=NEW,CATLG,DELETE recfm=FB lrecl=350 copybook=CVTRA05Y encoding=ascii

step STEP10R pgm=CBTRN03C
dd SYSOUT sysout
dd SYSPRINT sysout
dd TRANFILE dsn=AWS.M2.CARDDEMO.TRANSACT.DALY(+1) disp=SHR recfm=FB lrecl=350 copybook=CVTRA05Y encoding=ascii
dd CARDXREF dsn=AWS.M2.CARDDEMO.CARDXREF.VSAM.KSDS disp=SHR recfm=F lrecl=50 copybook=CVACT03Y encoding=ascii
dd TRANTYPE dsn=AWS.M2.CARDDEMO.TRANTYPE.VSAM.KSDS disp=SHR recfm=F lrecl=60 copybook=CVTRA03Y encoding=ascii
dd TRANCATG dsn=AWS.M2.CARDDEMO.TRANCATG.VSAM.KSDS disp=SHR recfm=F lrecl=60 copybook=CVTRA04Y encoding=ascii
# The start and end dates with one byte between them, laid out in CBTRN03C's own storage.
dd DATEPARM dsn=AWS.M2.CARDDEMO.DATEPARM disp=SHR recfm=F lrecl=80 copybook=- encoding=ascii
dd TRANREPT dsn=AWS.M2.CARDDEMO.TRANREPT(+1) disp=NEW,CATLG,DELETE recfm=FB lrecl=133 copybook=CVTRA07Y encoding=ascii
