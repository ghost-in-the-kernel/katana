# 8A.1's trial (research §48): one step accrues interest on each account. The cobc lane runs Katana's
# ACCRUE.cbl; the java lane runs a foreign port of it, which oracle/prove/Prove holds to the cobc lane.
job ACCRUE
profile ibm sha256:cc4bbf084793b6f5280da870d1aa7b6fb58d535dcfaf091d8436a36a66c4dae1
clock 2024-03-01 12:00:00.00 +00:00
tz UTC

dataset KATANA.FOREIGN.IN org=PS lrecl=20 from=repo:oracle/fixture/foreign/IN.txt framing=lines sha256=c663480d2648e36cfccb0572a897e1e1b234f7727b535c0beaaa847f98581748

step ACCRUE pgm=ACCRUE
dd SYSOUT sysout
dd INFILE dsn=KATANA.FOREIGN.IN disp=SHR recfm=F lrecl=20 copybook=ACCTREC encoding=ascii
dd OUTFILE dsn=KATANA.FOREIGN.OUT disp=NEW,CATLG,DELETE recfm=F lrecl=20 copybook=ACCTREC encoding=ascii
