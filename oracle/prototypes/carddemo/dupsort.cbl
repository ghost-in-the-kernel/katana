       IDENTIFICATION DIVISION.
       PROGRAM-ID. DUPSORT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT S-IN ASSIGN TO SORTIN ORGANIZATION SEQUENTIAL.
           SELECT S-OUT ASSIGN TO SORTOUT ORGANIZATION SEQUENTIAL.
           SELECT WK ASSIGN TO "SORTWK".
       DATA DIVISION.
       FILE SECTION.
       FD S-IN.
       01 IN-R PIC X(20).
       FD S-OUT.
       01 OUT-R PIC X(20).
       SD WK.
       01 WK-R.
          05 WK-KEY PIC X(2).
          05 WK-SEQ PIC X(18).
       PROCEDURE DIVISION.
           SORT WK ON ASCENDING KEY WK-KEY USING S-IN GIVING S-OUT.
           STOP RUN.
